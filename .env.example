# Copier en .env et compléter. Ne jamais versionner .env.
# Jeton Bearer exigé par l'API (aucune valeur par défaut : le service refuse de démarrer sans).
# Générer une valeur longue et aléatoire, par exemple : openssl rand -hex 32
API_TOKEN=
# Dossier des données (base SQLite jobs.db, sauvegardes backups/). /data dans le conteneur ;
# en dev hors Docker : DATA_DIR=var
DATA_DIR=/data
# Jours sans réponse après une candidature avant de suggérer une relance.
FOLLOW_UP_DAYS=14
# Jours de sauvegardes quotidiennes conservés.
BACKUP_KEEP_DAYS=14
# Dossiers Nextcloud par WebDAV (facultatif, désactivé par défaut ; voir README.md).
# true : retrouve le dossier de chaque offre, liste ses fichiers, crée celui des nouvelles offres.
NEXTCLOUD_WEBDAV=false
# Adresse de base de Nextcloud, sans chemin (ex. http://nextcloud.local:8080).
NEXTCLOUD_URL=
# Identifiant Nextcloud propriétaire des dossiers.
NEXTCLOUD_USER=
# Mot de passe d'application (Paramètres personnels > Sécurité), jamais le mot de passe du compte.
NEXTCLOUD_APP_PASSWORD=
# Dossier racine des candidatures dans Nextcloud (ex. /Candidatures).
NEXTCLOUD_ROOT=/Candidatures
# Fuseau horaire (date des sauvegardes quotidiennes).
TZ=Europe/Paris
# Facultatif : chemin explicite de departements.json (défaut : data/ à côté de backend/).
# GEO_REFERENTIAL=
# Facultatif : dossier du front compilé (phase 2 ; défaut backend/app/static s'il existe).
# FRONTEND_DIR=

# Côté CLI (cli/jobs.py), sur le poste qui l'utilise, pas dans le conteneur :
# JOBS_API_URL=http://localhost:8000
# JOBS_API_TOKEN=<même valeur que API_TOKEN>
